APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Minutes staff have to respond to a new booking/hire request before it's
# escalated to admins as overdue (app:escalate-overdue-booking-requests).
BOOKING_RESPONSE_SLA_MINUTES=15

# Laravel Reverb (self-hosted WebSocket server for live notifications/chat).
# Use this locally, where `php artisan reverb:start` can run as a persistent
# process. Generate fresh values with `php artisan reverb:install` (or set
# your own) — never reuse these placeholders in production. REVERB_APP_SECRET
# must stay server-side; only KEY/HOST/PORT/SCHEME are also needed by the
# frontend (as VITE_REVERB_* in frontend/.env).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# On shared/cPanel hosting, a self-hosted Reverb process can't run — switch
# BROADCAST_CONNECTION above to "pusher" and fill these from a Pusher
# Channels app (dashboard.pusher.com, free tier is enough for this app's
# volume). PUSHER_APP_SECRET stays server-side; KEY/CLUSTER also go to the
# frontend as VITE_PUSHER_APP_KEY/VITE_PUSHER_APP_CLUSTER, plus
# VITE_BROADCASTER=pusher (see frontend/.env).
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
