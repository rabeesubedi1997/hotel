VITE_API_URL=http://localhost:8002/api

# Which real-time transport src/services/echo.js connects with: "reverb"
# (self-hosted, this local setup) or "pusher" (hosted Pusher Channels, used
# on shared/cPanel hosting where a self-hosted Reverb process can't run).
VITE_BROADCASTER=reverb

# Laravel Reverb (real-time notifications/chat) — client-safe values only,
# must match backend/.env's REVERB_APP_KEY/HOST/PORT/SCHEME. Never put
# REVERB_APP_SECRET here — that stays server-side only.
VITE_REVERB_APP_KEY=sem6eu6fcnob3fzh4uzs
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Hosted Pusher Channels (only used when VITE_BROADCASTER=pusher). Client-safe
# values only — must match backend/.env's PUSHER_APP_KEY/CLUSTER. Never put
# PUSHER_APP_SECRET here.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=
